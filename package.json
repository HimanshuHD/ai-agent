{
  "name": "ai-agent",
  "version": "1.0.0",
  "description": "A learning project for building a local AI agent in TypeScript with Node.js and Ollama.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HimanshuHD/ai-agent.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/HimanshuHD/ai-agent/issues"
  },
  "homepage": "https://github.com/HimanshuHD/ai-agent#readme",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1"
  }
