{
  "name": "ai-agent",
  "version": "1.0.0",
  "description": "A learning project for building a local AI agent in TypeScript with Node.js and Ollama.",
  "scripts": {
    "build": "npm run build:cli && npm run web:build",
    "check": "tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.web.json --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "npm run build:cli && node --test tests/*.test.mjs",
    "build:cli": "tsc -p tsconfig.json",
    "web:dev": "vite --config vite.config.ts",
    "web:build": "vue-tsc -p tsconfig.web.json --noEmit && vite build --config vite.config.ts",
    "web:server": "node dist/server-cli.js",
    "test:browser": "npm run build && node tests/browser/web.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HimanshuHD/ai-agent.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/HimanshuHD/ai-agent/issues"
  },
  "homepage": "https://github.com/HimanshuHD/ai-agent#readme",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "vue": "^3.5.45"
  }
}
